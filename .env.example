# Server-side password for the attendance register.
# Set this in Vercel: Project -> Settings -> Environment Variables
# Add it for Production (and Preview/Development if needed), then redeploy.
#
# IMPORTANT: do NOT prefix this with VITE_. VITE_ variables are embedded in the
# public client bundle. SITE_PASSWORD is read only by middleware.js on the server.
SITE_PASSWORD=change-me
